# Public URL of the site (used for canonical URLs, sitemap, robots, OpenGraph, JSON-LD).
NEXT_PUBLIC_SITE_URL=https://example.com

# Windows installer URL. Leave empty to serve the installer shipped with the
# site (public/downloads, updated with `npm run publish:installer`); set it to
# host the installer elsewhere (e.g. a CDN or GitHub Releases).
NEXT_PUBLIC_WINDOWS_DOWNLOAD_URL=


# Optional links — only rendered when set.
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_DISCORD_URL=
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional cookieless analytics (Plausible-compatible). Nothing loads unless the domain is set.
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_SRC=
