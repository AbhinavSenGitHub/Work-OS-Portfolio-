{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/updates/:path*", "destination": "/workos/updates/:path*" },
    { "source": "/downloads/:path*", "destination": "/workos/downloads/:path*" },
    { "source": "/api/:path*", "destination": "/workos/api/:path*" },
    { "source": "/robots.txt", "destination": "/workos/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/workos/sitemap.xml" }
  ],
  "redirects": [
    { "source": "/", "destination": "/workos", "permanent": false },
    {
      "source": "/:path((?!workos(?:/|$)|updates/|downloads/|api/|robots\.txt$|sitemap\.xml$|_next/|_vercel/).*)",
      "destination": "/workos/:path",
      "permanent": false
    }
  ]
}
